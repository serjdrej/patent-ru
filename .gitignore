__pycache__/
*.pyc
*.pyo
.DS_Store

# Устаревшее расположение ключа ROSPATENT_API_KEY — начиная с этой версии ключ
# хранится вне дерева скилла (%LOCALAPPDATA%\rospatent на Windows, Keychain на
# macOS — см. scripts/keystore.py и .secrets/README.txt). Каталог оставлен в
# .gitignore на случай, если у кого-то ещё сохранился файл здесь со старой
# версии скилла: rospatent.py сам перенесёт его при первом обычном запуске.
.secrets/*
!.secrets/README.txt
