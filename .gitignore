__pycache__/
*.pyc
*.pyo
.DS_Store

# Устаревшее расположение ключа ROSPATENT_API_KEY — начиная с этой версии ключ
# хранится вне дерева скилла (%LOCALAPPDATA%\rospatent на Windows, Keychain на
# macOS, см. .secrets/README.txt и references/search-rospatent.md). Каталог
# оставлен в .gitignore на случай, если у кого-то ещё сохранился файл здесь
# со старой версии скилла (rospatent.ps1 сам перенесёт его при первом запуске).
.secrets/*
!.secrets/README.txt
